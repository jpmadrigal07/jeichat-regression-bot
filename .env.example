JEICHAT_BOT_TOKEN=jei_live_your_token_here
JEICHAT_API_URL=http://localhost:3001
JEICHAT_WEB_ORIGIN=http://localhost:3000

# Dev stack URLs for the *app under test* in verify prompts (defaults: JEICHAT_* above).
# Use when JeiChat and your product run on different ports (same as jeichat-code-bot).
# VERIFY_APP_WEB_ORIGIN=http://localhost:3000
# VERIFY_APP_API_ORIGIN=http://localhost:3001

# Fixer bot userId from GET /bots/@me on the fixer process (finds PR/Branch lines)
# FIXER_BOT_USER_ID=

# Checker bot userId (optional; narrows which CONFIRM message to use)
# CHECKER_BOT_USER_ID=

CURSOR_API_KEY=cursor_your_key_here
CURSOR_RUNTIME=cloud
CURSOR_REPO_URL=https://github.com/jpmadrigal07/jeichat
CURSOR_REPO_REF=main
CURSOR_MODEL=composer-2.5

# Cursor Dashboard → Cloud → Environments (DATABASE_URL, REVIEWER_TEST_EMAIL, …)
# CURSOR_CLOUD_ENVIRONMENT=jpmadrigal07/jeichat

# Post verification PNGs from a Cursor run to the ticket thread (default on)
# REVIEWER_POST_SCREENSHOTS=true
# REVIEWER_MAX_SCREENSHOTS=5

# Optional: GitHub token for private repos when resolving PR head refs (public repos work without it)
# GITHUB_TOKEN=

# Lean verification prompt (default on). Set REVIEWER_LIGHT_VERIFY=false for full test+dev+browser checklist.
# REVIEWER_LIGHT_VERIFY=true

# Max wait for a Cursor run before posting a timeout message (default 20 minutes)
# REVIEWER_RUN_TIMEOUT_MS=1200000
